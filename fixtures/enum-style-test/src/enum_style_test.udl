enum SimpleEnum {
    "VariantOne",
    "VariantTwo",
    "VariantThree",
};

[Enum]
interface ComplexEnum {
    VariantOne(u32 num);
    VariantTwo(f32 flt);
};

// Repeating the same named dependency used to make the C++ topological sorter
// emit that dependency's definition more than once.
dictionary RepeatedDependencies {
    SimpleEnum first;
    SimpleEnum second;
};

dictionary OptionalEnumDefault {
    SimpleEnum? value = "VariantOne";
};

namespace enum_style_test {
    SimpleEnum get_simple_enum();
    void set_simple_enum(SimpleEnum e);

    ComplexEnum get_complex_enum();
    void set_complex_enum(ComplexEnum e);

    RepeatedDependencies roundtrip_repeated_dependencies(RepeatedDependencies value);
    OptionalEnumDefault roundtrip_optional_enum_default(OptionalEnumDefault value);
};
